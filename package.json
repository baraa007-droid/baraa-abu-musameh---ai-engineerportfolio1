{
  "name": "baraa-ai-engineer-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && eslint server src server.ts tests",
    "test": "node --require ./scripts/test-guard.cjs --import tsx scripts/run_tests.ts",
    "test:unit": "node --require ./scripts/test-guard.cjs --import tsx --test tests/unit/*.test.ts tests/unit/*.test.tsx",
    "test:e2e": "node --require ./scripts/test-guard.cjs --import tsx scripts/e2e_isolated.ts",
    "db:migrate": "node --import tsx scripts/migrate_json_to_postgres.ts",
    "check:persistence-safety": "node --require ./scripts/runtime-bootstrap.cjs --import tsx scripts/check_persistence_safety.ts",
    "test:persistence": "node --require ./scripts/runtime-bootstrap.cjs --import tsx scripts/test_persistence_real.ts",
    "test:all": "npm run test:unit && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true,
    "@google/genai@2.18.0": true
  }
}
