# Copy to .env and fill in. Leave optional values EMPTY (not "CHANGE_ME"): a non-empty
# placeholder makes the app try to connect to it.

# --- Server -------------------------------------------------------------------
# Bind address of the Node server. 127.0.0.1 = this machine only (default). Docker sets 0.0.0.0.
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (required in production; "*" is rejected).
CORS_ORIGIN=http://localhost:3000
# Only behind a reverse proxy: a hop count (1 = one proxy, recommended), true (trust every hop)
# or comma-separated proxy addresses/subnets. Needed for real client IPs, HSTS and Secure cookies.
TRUST_PROXY=
# Max JSON body size (avatar uploads are cropped client-side; 2mb is enough).
MAX_BODY_SIZE=2mb
# Public form submissions allowed per IP per 10 minutes (contact + project intake).
FORM_RATE_LIMIT=5
# Where db.json is stored (default: ./.data). Tests always use a temporary directory.
DATA_DIR=

# --- Admin authentication ------------------------------------------------------
# At least 12 characters in production. Changing it logs out every admin session.
ADMIN_PASSWORD=
# Random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Salts the session fingerprint; changing it also logs out every admin session.
ADMIN_SESSION_SECRET=
# The admin UI signs in with an HttpOnly, SameSite=Strict cookie plus a per-session CSRF token.
# true = the cookie always carries the Secure flag (set this once the site is served over HTTPS;
# admin login over plain http:// then stops working on purpose). Empty = Secure only for requests
# that arrive over HTTPS (behind a proxy that requires TRUST_PROXY).
SESSION_COOKIE_SECURE=

# --- AI providers (optional; without keys the site uses honest data-driven fallbacks) ---
AI_PRIMARY_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Independent OpenRouter fallback router; resolves to an available free model when possible.
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free
# Ordered, explicit zero-cost OpenRouter chat fallbacks. Every entry must end in :free.
OPENROUTER_FREE_MODELS=inclusionai/ling-3.2-flash:free
# Gemini: secondary LLM and the embedding provider for RAG vectors.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2

# --- PostgreSQL (local optional; required for Vercel production/Preview) -------
DATABASE_URL=
# disable | no-verify (encrypted, certificate not checked) | verify-full (recommended for remote DBs)
PG_SSL_MODE=
# load (default: PG content replaces db.json on startup, after a snapshot) | mirror (db.json is
# authoritative, PG receives writes) | off (ignore DATABASE_URL). See DEPLOYMENT.md before changing.
PG_SYNC_MODE=load

# --- Redis (local optional; required for Vercel production/Preview) -------------
REDIS_URL=

# --- Docker Compose only ---------------------------------------------------------
# Required by docker-compose.yml (compose refuses to start without them).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio_db
REDIS_PASSWORD=
# 127.0.0.1 keeps the published ports (3001, 3002, 5432, 6379) off the local network.
BIND_ADDRESS=127.0.0.1

# --- Notifications (optional) -----------------------------------------------------
NOTIFICATIONS_ENABLED=true
# smtp | none
EMAIL_PROVIDER=none
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Gmail: use an App Password, never the account password.
SMTP_PASS=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_ENABLED=false

# --- Browser end-to-end script (scripts/test_e2e_browser.ts) only -----------------
E2E_ADMIN_PASSWORD=
